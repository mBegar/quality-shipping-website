---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portAerial from '../assets/photos/port-aerial.jpg';

interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = 'Planning Your Next Shipment?',
  text = 'Let our team help you explore a freight forwarding solution for your business.',
  primaryLabel = 'Request a Quote',
  primaryHref = '/request-a-quote',
  secondaryLabel = 'Contact Our Team',
  secondaryHref = '/contact',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="cta-band__media">
    <Image src={portAerial} alt="" layout="full-width" widths={[640, 1024, 1600]} sizes="100vw" quality={70} />
  </div>
  <div class="container cta-band__inner reveal">
    <div>
      <p class="eyebrow eyebrow--light">Get Started</p>
      <h2 id="cta-band-title">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="btn-group">
      <a href={primaryHref} class="btn btn--primary btn--lg">{primaryLabel}<Icon name="arrow-right" class="arrow" /></a>
      <a href={secondaryHref} class="btn btn--outline-light btn--lg">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    color: #fff;
    overflow: hidden;
  }
  .cta-band__media,
  .cta-band__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .cta-band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgb(0 45 72 / 0.96) 0%, rgb(0 45 72 / 0.9) 50%, rgb(0 95 125 / 0.78) 100%);
  }
  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
  }
  .cta-band h2 {
    color: #fff;
    font-size: var(--text-3xl);
  }
  .cta-band .lead {
    color: rgb(255 255 255 / 0.8);
    margin-top: 0.85rem;
    max-width: 36rem;
  }
</style>
