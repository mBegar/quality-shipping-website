---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
  alt: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, lead, image, alt, crumbs = [] } = Astro.props;
---

<section class="page-banner">
  <div class="page-banner__media">
    <Image src={image} alt={alt} layout="full-width" widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" quality={78} />
  </div>
  <div class="container">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="/">Home</a></li>
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
