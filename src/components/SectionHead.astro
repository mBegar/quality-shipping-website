---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center' | 'split';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}
const { eyebrow, title, lead, align = 'left', as: Tag = 'h2', class: className } = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': align === 'center', 'section-head--split': align === 'split' }, 'reveal', className]}>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag>{title}</Tag>
    {lead && <p class="lead">{lead}</p>}
  </div>
  {align === 'split' && <slot />}
</div>
