---
/**
 * Dotted world map with India highlighted and animated trade lanes.
 *
 * Land dots are served as a cached static SVG (/images/world-dots.svg);
 * India, the hub and the lanes are inline so they can be styled and animated.
 *
 * Lanes: a script draws a lane from India to one destination country after
 * another (ordered list in src/data/world-dots.json, generated by
 * scripts/generate-world-map.mjs — see the exclusion note there), looping
 * continuously while the map is on screen. With `prefers-reduced-motion`,
 * or without JavaScript, a static set of regional lanes is shown instead.
 */
import worldDots from '../data/world-dots.json';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const [, , vbW, vbH] = worldDots.viewBox.split(' ').map(Number);

// Approximate positions in map viewBox units. Indicative only.
const hub = { x: 686, y: 405 };
const staticLanes = [
  { to: { x: 492, y: 288 }, label: 'Europe' },
  { to: { x: 628, y: 393 }, label: 'Middle East' },
  { to: { x: 782, y: 447 }, label: 'South-East Asia' },
  { to: { x: 812, y: 370 }, label: 'East Asia' },
  { to: { x: 236, y: 304 }, label: 'North America' },
  { to: { x: 586, y: 455 }, label: 'East Africa' },
  { to: { x: 846, y: 540 }, label: 'Australia' },
];
const arc = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const dist = Math.hypot(b.x - a.x, b.y - a.y);
  const lift = Math.min(120, dist * 0.28);
  return `M${a.x} ${a.y} Q${mx} ${my - lift} ${b.x} ${b.y}`;
};
---

<div class:list={['world-map', className]} aria-hidden="true" style={`--vb-w:${vbW};--vb-h:${vbH}`} data-hub-x={hub.x} data-hub-y={hub.y}>
  <img src="/images/world-dots.svg" alt="" width={vbW} height={vbH} decoding="async" class="world-map__land" />
  <svg viewBox={worldDots.viewBox} class="world-map__overlay" xmlns="http://www.w3.org/2000/svg">
    <path d={worldDots.india} class="world-map__india" />
    <g class="world-map__static">
      {staticLanes.map((l, i) => <path d={arc(hub, l.to)} class="world-map__lane" pathLength="1" style={`--i:${i}`} />)}
      {staticLanes.map((l) => <circle cx={l.to.x} cy={l.to.y} r="3.2" class="world-map__node" />)}
    </g>
    <g class="world-map__trail" />
    <g class="world-map__live" />
    <circle cx={hub.x} cy={hub.y} r="5" class="world-map__hub" />
    <circle cx={hub.x} cy={hub.y} r="5" class="world-map__pulse" />
    <circle cx={hub.x} cy={hub.y} r="5" class="world-map__pulse world-map__pulse--2" />
  </svg>
  <p class="world-map__label" data-label>
    <span class="world-map__label-from">India</span>
    <span class="world-map__label-arrow">→</span>
    <span class="world-map__label-to" data-label-to></span>
  </p>
  <script is:inline type="application/json" data-destinations set:html={JSON.stringify(worldDots.destinations)} />
</div>

<style>
  .world-map {
    position: relative;
    width: 100%;
    aspect-ratio: var(--vb-w) / var(--vb-h);
  }
  .world-map__land,
  .world-map__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .world-map__india {
    fill: none;
    stroke: var(--teal-400);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .world-map__lane {
    fill: none;
    stroke: var(--teal-400);
    stroke-width: 1.4;
    stroke-opacity: 0.8;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-linecap: round;
  }
  .world-map__node {
    fill: var(--teal-300);
    opacity: 0;
  }
  .world-map__hub {
    fill: #fff;
    stroke: var(--teal-400);
    stroke-width: 2.5;
  }
  .world-map__pulse {
    fill: none;
    stroke: var(--teal-400);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }

  /* Live (JS-driven) lanes */
  .world-map--live .world-map__static {
    display: none;
  }
  .world-map__live :global(.lane) {
    fill: none;
    stroke: var(--teal-300);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 2px rgb(127 211 236 / 0.6));
  }
  .world-map__live :global(.node) {
    fill: #fff;
    stroke: var(--teal-400);
    stroke-width: 1.5;
    opacity: 0;
  }
  .world-map__live :global(.ring) {
    fill: none;
    stroke: var(--teal-300);
    stroke-width: 1.2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .world-map__trail :global(circle) {
    fill: var(--teal-400);
    opacity: 0.45;
  }

  /* Current destination label */
  .world-map__label {
    position: absolute;
    left: 0;
    bottom: 4%;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: rgb(0 45 72 / 0.72);
    border: 1px solid rgb(127 211 236 / 0.3);
    backdrop-filter: blur(6px);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.85);
    white-space: nowrap;
  }
  .world-map--live .world-map__label {
    display: inline-flex;
  }
  .world-map__label-arrow {
    color: var(--teal-300);
  }
  .world-map__label-to {
    color: #fff;
    min-width: 6ch;
    transition: opacity 250ms var(--ease-out);
  }
  .world-map__label-to[data-swap] {
    opacity: 0;
  }
  @media (max-width: 640px) {
    .world-map {
      display: flex;
      flex-direction: column;
      aspect-ratio: auto;
    }
    .world-map__land,
    .world-map__overlay {
      position: static;
      height: auto;
      aspect-ratio: var(--vb-w) / var(--vb-h);
    }
    .world-map__overlay {
      position: absolute;
      inset: 0 0 auto 0;
    }
    .world-map__label {
      position: static;
      align-self: flex-start;
      margin-top: 0.75rem;
    }
  }

  /* Static fallback animation (no JS / reduced motion) */
  :global(.is-visible) .world-map__lane {
    animation: lane-draw 1.6s var(--ease-out) forwards;
    animation-delay: calc(300ms + var(--i) * 140ms);
  }
  :global(.is-visible) .world-map__node {
    animation: node-in 500ms var(--ease-out) forwards;
    animation-delay: 1.6s;
  }
  :global(.is-visible) .world-map__pulse {
    animation: pulse 2.8s ease-out infinite;
  }
  :global(.is-visible) .world-map__pulse--2 {
    animation-delay: 1.4s;
  }
  @keyframes lane-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes node-in {
    to {
      opacity: 1;
    }
  }
  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }
    100% {
      transform: scale(5);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .world-map__lane {
      stroke-dashoffset: 0;
      animation: none !important;
    }
    .world-map__node {
      opacity: 1;
      animation: none !important;
    }
    .world-map__pulse {
      animation: none !important;
    }
  }
</style>

<script>
  import { startTradeLanes } from '../scripts/trade-lanes';
  document.querySelectorAll<HTMLElement>('.world-map').forEach(startTradeLanes);
</script>
