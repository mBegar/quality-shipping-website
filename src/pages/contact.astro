---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { company, formattedAddress, mapEmbedUrl, SITE_URL } from '../data/site';
import officeTowers from '../assets/photos/office-towers.jpg';

const title = 'Contact Us';
const description =
  'Contact Quality Shipping Services, freight forwarder in Jayanagar, Bengaluru. Call +91 99459 02055 or email info@qualityshipping.in for freight enquiries.';
const crumbs = [{ label: 'Contact Us' }];
---

<BaseLayout
  title={title}
  description={description}
  crumbs={crumbs}
  schema={[
    {
      '@type': 'ContactPage',
      name: 'Contact Quality Shipping Services',
      url: `${SITE_URL}/contact`,
    },
  ]}
>
  <PageBanner
    eyebrow="Contact Us"
    title="Let's Talk About Your Logistics"
    lead="Whether you are planning a single shipment or looking for an ongoing freight forwarding partner, our team is ready to help."
    image={officeTowers}
    alt="Modern office towers viewed from street level"
    crumbs={crumbs}
  />

  <section class="section contact">
    <div class="container contact__grid">
      <div class="contact__info">
        <div class="reveal">
          <p class="eyebrow">Get in Touch</p>
          <h2>Our Office</h2>
          <p class="lead">We are based in Bengaluru and work with customers across India and overseas.</p>
        </div>

        <ul class="contact__cards">
          <li class="contact-card reveal" style="--d:80ms">
            <span class="icon-badge"><Icon name="map-pin" /></span>
            <div>
              <h3>Registered Office</h3>
              <address>
                <strong>{company.legalName}</strong><br />
                {formattedAddress.map((line, i) => (<>{line}{i < formattedAddress.length - 1 && <br />}</>))}
              </address>
              <p class="contact-card__links">
                <a href={company.map.placeUrl} target="_blank" rel="noopener noreferrer">View on Google Maps <Icon name="arrow-up-right" /></a>
                <a href={company.map.directionsUrl} target="_blank" rel="noopener noreferrer">Get directions <Icon name="arrow-up-right" /></a>
              </p>
            </div>
          </li>
          <li class="contact-card reveal" style="--d:140ms">
            <span class="icon-badge"><Icon name="mail" /></span>
            <div>
              <h3>Email</h3>
              <a href={`mailto:${company.email}`}>{company.email}</a>
              <p class="contact-card__hint">For quotations, documentation and general enquiries.</p>
            </div>
          </li>
          <li class="contact-card reveal" style="--d:200ms">
            <span class="icon-badge"><Icon name="phone" /></span>
            <div>
              <h3>Telephone</h3>
              {
                company.phone ? (
                  <a href={`tel:${company.phone.replace(/\s+/g, '')}`}>{company.phone}</a>
                ) : (
                  <p class="contact-card__placeholder">
                    <span class="placeholder-tag">To be confirmed</span>
                    <span class="contact-card__hint">Telephone number will be published once verified.</span>
                  </p>
                )
              }
            </div>
          </li>
          <li class="contact-card reveal" style="--d:260ms">
            <span class="icon-badge"><Icon name="clock" /></span>
            <div>
              <h3>Business Hours</h3>
              <dl class="hours">
                {
                  company.businessHours.map((h) => (
                    <div>
                      <dt>{h.days}</dt>
                      <dd>{h.hours}</dd>
                    </div>
                  ))
                }
              </dl>
              <p class="contact-card__hint">Enquiries received outside these hours are answered on the next working day.</p>
            </div>
          </li>
        </ul>

        <div class="contact__cta reveal" style="--d:300ms">
          <div>
            <h3>Have a shipment in mind?</h3>
            <p>Use our detailed enquiry form to receive a tailored freight proposal.</p>
          </div>
          <a href="/request-a-quote" class="btn btn--primary">Request a Quote <Icon name="arrow-right" class="arrow" /></a>
        </div>
      </div>

      <div class="contact__form reveal" style="--d:120ms">
        <div class="contact__form-card">
          <h2>Send Us a Message</h2>
          <p>Complete the form and a member of our team will get back to you.</p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <section class="map" aria-label="Office location map">
    <iframe
      src={mapEmbedUrl}
      title={`Map showing the office location of ${company.legalName}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    />
    <div class="map__bar">
      <div class="container map__bar-inner">
        <p>
          <Icon name="map-pin" />
          <span>{company.legalName}, {formattedAddress.slice(0, 3).join(', ')}</span>
        </p>
        <a href={company.map.directionsUrl} class="btn btn--navy btn--sm" target="_blank" rel="noopener noreferrer">
          Get Directions <Icon name="arrow-up-right" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 3rem 4rem;
    align-items: start;
  }
  .contact__info .lead {
    margin-top: 1rem;
  }
  .contact__cards {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .contact-card {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-0);
  }
  .contact-card h3 {
    font-size: var(--text-base);
    margin-bottom: 0.4rem;
  }
  .contact-card address {
    font-style: normal;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--ink-600);
  }
  .contact-card address strong {
    color: var(--ink-900);
  }
  .contact-card a {
    font-weight: 600;
    word-break: break-all;
  }
  .contact-card__hint {
    margin-top: 0.4rem;
    font-size: var(--text-xs);
    color: var(--ink-500);
  }
  .contact-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
  }
  .contact-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--teal-600);
    word-break: normal;
  }
  .contact-card__links :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }
  .hours {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
  }
  .hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .hours dt {
    color: var(--ink-600);
  }
  .hours dd {
    margin: 0;
    font-weight: 600;
    color: var(--ink-900);
    text-align: right;
  }
  .contact__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--teal-50);
    border: 1px solid #cfe7f0;
  }
  .contact__cta h3 {
    font-size: var(--text-lg);
  }
  .contact__cta p {
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    color: var(--ink-600);
  }
  .contact__form-card {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-0);
    box-shadow: var(--shadow);
  }
  .contact__form-card h2 {
    font-size: var(--text-2xl);
  }
  .contact__form-card > p {
    margin: 0.6rem 0 1.75rem;
    color: var(--ink-600);
  }
  .map iframe {
    display: block;
    width: 100%;
    height: clamp(20rem, 40vw, 30rem);
    border: 0;
    filter: grayscale(0.2);
  }
  .map__bar {
    background: var(--surface-0);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 0.9rem;
  }
  .map__bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .map__bar p {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-sm);
    color: var(--ink-600);
  }
  .map__bar p :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    color: var(--teal-600);
  }
  @media (max-width: 1024px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
