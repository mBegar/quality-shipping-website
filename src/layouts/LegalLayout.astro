---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description} crumbs={[{ label: title }]}>
  <section class="legal-head bg-navy">
    <div class="container container--narrow">
      <p class="eyebrow">Legal</p>
      <h1>{title}</h1>
      <p class="legal-head__meta">Last updated: {updated}</p>
    </div>
  </section>
  <section class="section--sm section">
    <div class="container container--narrow">
      <article class="prose legal-body">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-head {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .legal-head h1 {
    font-size: var(--text-4xl);
  }
  .legal-head__meta {
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.6);
  }
  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }
</style>
